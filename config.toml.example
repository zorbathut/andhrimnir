[ble]
address = "XX:XX:XX:XX:XX:XX"
char_uuid = "0000ffb2-0000-1000-8000-00805f9b34fb"
reconnect_delay = 5.0

[esp]
host = "192.168.1.100"
port = 6053
password = ""
noise_psk = ""

[server]
host = "0.0.0.0"
port = 8000
db_path = "andhrimnir.db"
# "esp" reads probes through the ESPHome bluetooth_proxy, "ble" through this host's
# own radio.  Defaults to "esp" when esp.host is set, otherwise "ble".
source = "esp"
